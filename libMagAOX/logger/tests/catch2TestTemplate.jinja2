/** Class to encapsulate {{name}} flatbuffer data using
 ** => types/{{name}}.hpp
 ** => types/generated/{{name}}_generated.h
 **/
class {{className}}_{{outerLoopI}}
{
public:
  // Saved input parameter value; unused
  {% for field in msgType %}
  {{field.type}} m_save{{UPPER_FIRST_CHAR(classVarName)}}{{UPPER_FIRST_CHAR(field.name)}};
  {% endfor %}

  // Parameters retrieved from flatbuffer
  {% for field in msgType %}
  {{field.type}} m_{{field.name}};
  {% endfor %}

  // Flatbuffers verifier success/failure
  bool m_verify{false};

  // Whether the code-generated central dispatchers (logVerify/logCodeValid/logStdFormat)
  // agree with calling this log type directly -- this is what exercises those dispatch
  // switches' case for this type, one real type at a time via this same generator.
  bool m_centralDispatchOk{false};

  // Whether every logMetaDetail accessor this type registers via getAccessor() -- the
  // function pointer used by the telemetry/FITS-header system to read a field indirectly
  // -- actually reads back the same value obtained directly from the flatbuffer above.
  // getAccessor() takes the address of each of these functions regardless of which
  // branch runs at runtime, so calling them here (once per real field, generated instead
  // of hand-enumerated) is what exercises their bodies instead of just their addresses.
  bool m_accessorsOk{false};

  // flatbuffer data length; used in ::verify
  int L;

  // Constructor
  {{className}}_{{loop.index0}}({%- for field in msgType -%}
  {%- if 'defaultArg' in field and field.defaultArg -%}
  {%- else -%}{{field.type}} {{field.name}}_{% if not loop.last and 'defaultArg' not in loop.nextitem%}, {% endif -%}{% endif -%}
  {%- endfor -%}
  ) {
    // Save input parameters
    {% for field in msgType %}
    {% if 'defaultArg' not in field %}
    m_save{{UPPER_FIRST_CHAR(classVarName)}}{{UPPER_FIRST_CHAR(field.name)}} = {{field.name}}_;
    {% endif %}
    {% endfor %}

    // Create the flatbuffer messageT using the input parameters
    auto {{classVarName}} = MagAOX::logger::{{name}}::messageT({%- for field in msgType -%}
    {%- if 'defaultArg' in field and field.defaultArg -%}
    {%- else -%}{{field.name}}_{% if not loop.last and 'defaultArg' not in loop.nextitem%}, {% endif -%}{% endif -%}
    {%- endfor -%});

    // Retrieve flatbuffer pointer (if not an empty_log type) and length
    {% if "empty_log" not in baseType %}
    void* buffPtr = {{classVarName}}.builder.GetBufferPointer();
    {% endif %}
    L = MagAOX::logger::{{name}}::length({{classVarName}});

    // Retrieve the flatbuffer parameters for Catch2 comparison below
    {%for field in msgType %}
    {% if "schemaName" in field %}
    {% set getter = field.schemaName %}
    {% else %}
    {% set getter = field.name %}
    {% endif %}
    {% if schemaTableName != "" %}
    {% set fbName = schemaTableName %}
    {% else %}
    {% set fbName = UPPER_FIRST_CHAR(name) + "_fb" %}
    {% endif %}
    {% if "std::vector" in field.type %}
    {% if "std::string" in field.vectorType %}
    {% set pushVal = "it->str()" %}
    {% else %}
    {% set pushVal = "*it" %}
    {% endif %}
    if (MagAOX::logger::Get{{fbName}}(buffPtr)->{{getter}}() != nullptr)
    {
      for(auto it = MagAOX::logger::Get{{fbName}}(buffPtr)->{{getter}}()->begin();
          it != MagAOX::logger::Get{{fbName}}(buffPtr)->{{getter}}()->end();
          ++it)
      {
        m_{{field.name}}.push_back({{pushVal}});
      }
    }
    {% elif 'std::string' in field.type %}
    m_{{field.name}} = std::string(MagAOX::logger::Get{{fbName}}(buffPtr)->{{getter}}()->c_str());
    {% elif 'char *' in field.type %}
    size_t {{field.name}}StrLen = strlen(MagAOX::logger::Get{{fbName}}(buffPtr)->{{getter}}()->c_str()) + 1;
    m_{{field.name}} = (char *) malloc({{field.name}}StrLen);
    strncpy(m_{{field.name}}, MagAOX::logger::Get{{fbName}}(buffPtr)->{{getter}}()->c_str(), {{field.name}}StrLen);
    {% else %}
    m_{{field.name}} = MagAOX::logger::Get{{fbName}}(buffPtr)->{{getter}}();
    {% endif %}
    {% endfor %}

    // Run the {{name}} verifier
    m_verify = verify({{classVarName}});

    // Cross-check the central, code-generated dispatchers against calling this type
    // directly, instead of hand-enumerating every event code's expected behavior here.
    m_centralDispatchOk = checkCentralDispatch({{classVarName}});

    // Exercise every getAccessor() function pointer this type registers.
    m_accessorsOk = checkAccessors({{classVarName}});
  }

  // Invokes each of this type's getAccessor()-registered accessor function pointers
  // against a real serialized buffer and confirms it reads back the same value already
  // retrieved directly from the flatbuffer above.
  bool checkAccessors(const typename MagAOX::logger::{{name}}::messageT& msg) {
{% if accessorChecks|length == 0 %}
    static_cast<void>(msg);
    return true;
{% else %}
    flatlogs::timespecX tsx{0,0};
    flatlogs::logPrioT prio{flatlogs::logPrio::LOG_DEFAULT};

    flatlogs::bufferPtrT logBuffer;
    {% if 'software_log' in name %}
    flatlogs::logHeader::createLog<MagAOX::logger::software_notice>(logBuffer
                                                             , tsx, msg
                                                             , prio);
    {% else %}
    flatlogs::logHeader::createLog<MagAOX::logger::{{name}}>(logBuffer
                                                             , tsx, msg
                                                             , prio);
    {% endif %}
    void* msgBuffer = flatlogs::logHeader::messageBuffer(logBuffer);

    bool ok = true;
    {% for accessor in accessorChecks %}
    {
        auto detail = MagAOX::logger::{{name}}::getAccessor("{{accessor.member}}");
        if (detail.accessor == nullptr)
        {
            ok = false;
        }
        // Cross-check the central, code-generated member-accessor dispatcher (a switch
        // over every real event code, generated into logger/generated/) against calling
        // this type directly, instead of hand-enumerating every event code here too.
        if (MagAOX::logger::logMemberAccessor(MagAOX::logger::{{name}}::eventCode, "{{accessor.member}}").accessor != detail.accessor)
        {
            ok = false;
        }
    {% if accessor.compareValue %}
        // Cast the raw field value the same way the accessor's own return statement
        // implicitly would (e.g. truncating/truthiness conversions for narrower or
        // bool-typed accessors), so this compares like-for-like instead of assuming the
        // raw field is preserved exactly.
        else if (!(reinterpret_cast<{{accessor.cppType}}(*)(void*)>(detail.accessor)(msgBuffer) == static_cast<{{accessor.cppType}}>(m_{{accessor.funcName}})))
        {
            ok = false;
        }
    {% else %}
        else
        {
            // Return type doesn't correspond 1:1 with the raw field (e.g. a formatted
            // string derived from a non-string field, or a differently-typed vector) --
            // still invoke it to exercise its body, without asserting a specific value.
            static_cast<void>(reinterpret_cast<{{accessor.cppType}}(*)(void*)>(detail.accessor)(msgBuffer));
        }
    {% endif %}
    }
    {% endfor %}
    return ok;
{% endif %}
  }

  // Cross-checks logVerify/logCodeValid/logStdFormat (each a switch over every real event
  // code, generated into logger/generated/) against calling this type directly.
  bool checkCentralDispatch(const typename MagAOX::logger::{{name}}::messageT& msg) {

    flatlogs::timespecX tsx{0,0};
    flatlogs::logPrioT prio{flatlogs::logPrio::LOG_DEFAULT};

    flatlogs::bufferPtrT logBuffer;
    {% if 'software_log' in name %}
    flatlogs::logHeader::createLog<MagAOX::logger::software_notice>(logBuffer
                                                             , tsx, msg
                                                             , prio);
    {% else %}
    flatlogs::logHeader::createLog<MagAOX::logger::{{name}}>(logBuffer
                                                             , tsx, msg
                                                             , prio);
    {% endif %}

    bool verifyMatches = ( MagAOX::logger::logVerify(MagAOX::logger::{{name}}::eventCode, logBuffer, L)
                           == MagAOX::logger::{{name}}::verify(logBuffer, L) );

    bool codeIsValid = MagAOX::logger::logCodeValid(MagAOX::logger::{{name}}::eventCode);

    std::ostringstream oss;
    MagAOX::logger::logStdFormat(oss, logBuffer);

    // The other three code-generated formatting dispatchers, each also a switch over
    // every real event code: short (used by logdump), min (used by MagAOXApp's INDI
    // log forwarding), and json (used by logdump's json output; also runtime-initializes
    // the per-type flatbuffer binary schemas from binarySchemata.inc).
    MagAOX::logger::logShortStdFormat(oss, "testapp", logBuffer);
    MagAOX::logger::logMinStdFormat(oss, logBuffer);
    MagAOX::logger::logJsonFormat(oss, logBuffer);

    // Round-trip this type's event code through the code<->name lookup tables (rather
    // than hand-enumerating the expected name string here) to exercise both of their
    // per-code branches.
    bool codeNameRoundTrip = ( MagAOX::logger::eventCode(MagAOX::logger::eventCodeName(MagAOX::logger::{{name}}::eventCode))
                                == MagAOX::logger::{{name}}::eventCode );

    // Cross-check logMemberAccessor's switch-case dispatch for this type's event code
    // (unconditionally, even for types with no getAccessor()-registered fields at all --
    // the per-field checks in checkAccessors() below only run when such fields exist).
    bool memberAccessorDispatchOk = ( MagAOX::logger::logMemberAccessor(MagAOX::logger::{{name}}::eventCode, "").accessor
                                       == MagAOX::logger::{{name}}::getAccessor("").accessor );

    return verifyMatches && codeIsValid && !oss.str().empty() && codeNameRoundTrip && memberAccessorDispatchOk;
  }

  // Run the flatbuffer Verifier for this log type
  // - requires bufferPtrT (shared_ptr<char*>) to full log entry
  //   comprising log header plus flatbuffer log message
  bool verify(const typename MagAOX::logger::{{name}}::messageT& msg) {

    // Timestamp, prioriy (use nominal value here)
    flatlogs::timespecX tsx{0,0};
    flatlogs::logPrioT prio{flatlogs::logPrio::LOG_DEFAULT};

    // Create full log: log header(*); log message (+)
    // * Log level (priority)
    // * Event code (implicit in <MagAOX::logger::type>)
    // * Timestamp
    // * Message size (variable length; 1, 2, or 8 bytes)
    // + Message (variable length)

    // N.G. allocates space and writes pointer value to logBuffer
    flatlogs::bufferPtrT logBuffer;
    {% if 'software_log' in name %}
    flatlogs::logHeader::createLog<MagAOX::logger::software_notice>(logBuffer
                                                             , tsx, msg
                                                             , prio);
    {% else %}
    flatlogs::logHeader::createLog<MagAOX::logger::{{name}}>(logBuffer
                                                             , tsx, msg
                                                             , prio);
    {% endif %}
    // Run full log through flatbuffer Verifier
    return MagAOX::logger::{{name}}::verify(logBuffer,L);
  }
};

SCENARIO( "Create {{name}} {{outerLoopI}}", "[a log item]")
{
    GIVEN("a {{name}} log code")
    {
        WHEN("random values for fields")
        {
            // Create flatbuffer
            {{className}}_{{outerLoopI}} {{classVarName}} = {{className}}_{{outerLoopI}}({%- for field in msgType -%}
            {%- if 'defaultArg' not in field -%}
            {%- set argName = nameCamelCase + UPPER_FIRST_CHAR(field.name) + "_" + outerLoopI|string -%}
            {# Need additional cast for char * types to bypass const #}
            {%- if "char *" in field.type %}
            {%- set argName = "(char *) " + argName -%}
            {%- endif -%}
            {%- if loop.last %}{{argName}}
            {%- else -%}{{argName}}{% if not loop.last and 'defaultArg' not in loop.nextitem%}, {% endif -%}{% endif -%}
            {%- endif -%}
            {%- endfor -%}
            );
            // Compare flatbuffer parameters
            {% for field in msgType %}
            {% if "specialAssertVal" in field %}
            {% set testVarName = nameCamelCase + "Special" + UPPER_FIRST_CHAR(field.name) + "_" + outerLoopI|string %}
            {% elif "defaultArg" in field and "defaultTestVal" in field%}
            {% set testVarName = field.defaultTestVal %}
            {% else %}
            {% set testVarName = nameCamelCase + UPPER_FIRST_CHAR(field.name) + "_" + outerLoopI|string %}
            {% endif %}
            {% if "defaultArg" in field and "defaultTestVal" not in field %}
            {% elif 'char *' in field.type %}
            REQUIRE(strcmp({{classVarName}}.m_{{field.name}}, {{testVarName}}) == 0);
            {% else %}
            REQUIRE({{classVarName}}.m_{{field.name}} == {{testVarName}});
            {% endif %}
            {% endfor %}
            REQUIRE({{classVarName}}.m_verify);
            REQUIRE({{classVarName}}.m_centralDispatchOk);
            REQUIRE({{classVarName}}.m_accessorsOk);
        }
    }
}

